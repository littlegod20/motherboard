{
  "expo": {
    "name": "Motherboard",
    "slug": "motherboard",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0D12",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "BoardScan uses the camera to identify motherboard components.",
        "NSPhotoLibraryUsageDescription": "BoardScan lets you pick a motherboard photo to identify components."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.littlegod4.motherboard",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "EXPO_PUBLIC_API_URL": "http://localhost:3000/api/v1",
      "eas": {
        "projectId": "656785df-f8fa-4aa5-b7e8-c0865e39a747"
      }
    },
    "plugins": [
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow BoardScan to use the camera for motherboard scans."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow BoardScan to access photos for motherboard scans."
        }
      ]
    ]
  }
}
