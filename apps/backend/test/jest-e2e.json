{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": [
      "ts-jest",
      {
        "tsconfig": {
          "rootDir": ".",
          "ignoreDeprecations": "6.0"
        }
      }
    ]
  },
  "setupFiles": ["<rootDir>/setup-e2e.ts"],
  "testTimeout": 60000,
  "forceExit": true
}
